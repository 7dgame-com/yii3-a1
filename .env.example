# MrPP API - Environment Configuration
# Copy this file to .env and update the values for your environment.

# MySQL Database
MYSQL_HOST=localhost
MYSQL_DB=mrpp
MYSQL_USER=root
MYSQL_PASS=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT - Path to the secret key file used for HS256 signing
JWT_KEY=/path/to/jwt-secret.key

# White-label plugin internal API (token must be at least 32 characters)
# Required for /v1/white-label-configs?o=...&d=...
WHITELABEL_SERVICE_URL=http://host.docker.internal:8093
WHITELABEL_INTERNAL_TOKEN=replace-with-a-long-random-shared-token

# Application
YII_DEBUG=false
YII_ENV=production
YII_CHECK_EVENTS=false
