# MrPP API - Environment Configuration
# Copy this file to .env and update the values for your environment.

# MySQL Database
# SN authentication must use the same authoritative database/device_sn table as
# the management API. Do not create or copy a second SN binding database.
MYSQL_HOST=localhost
MYSQL_DB=mrpp
MYSQL_USER=root
MYSQL_PASS=

# Redis
# All y1 nodes share this environment's authoritative Redis DB for refresh and SN limits.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Legacy refresh response continuity (candidate; no independent readiness).
# Keep off until exact metadata backfill and all issuer/security boundaries pass.
Y1_REFRESH_REPLAY_ENABLED=false
# Stable 32 random bytes, canonical unpadded base64url; private operator handoff.
# Never derive from JWT, auto-generate at startup, or print this server secret.
Y1_REFRESH_REPLAY_KEY=

# Independent identity authority. Keep legacy until accounts, all y1 refresh
# sessions (including dsn_ provenance), QR context and old HS256 trust are ready.
IDENTITY_DATA_SOURCE=legacy
IDENTITY_INDEPENDENT_READY=false
IDENTITY_AUTH_BASE_URL=
IDENTITY_AUTH_TIMEOUT_MS=1500
IDENTITY_INTERNAL_API_TOKEN=
# Scoped overrides fall back to the general internal token when empty.
IDENTITY_TOKEN_ISSUANCE_INTERNAL_API_TOKEN=
IDENTITY_ACCOUNT_INTERNAL_TOKEN=
IDENTITY_IAM_INTERNAL_API_TOKEN=

# QR login-code migration protocol. Keep these database defaults until the
# develop rollout explicitly enables a Redis phase.
LOGIN_CODE_READ_MODE=database
LOGIN_CODE_WRITE_MODE=database
LOGIN_CODE_REDIS_PREFIX=auth:login-code:v1
LOGIN_CODE_PROTOCOL_FINGERPRINT=8cb6c5546bf71994bca800431fc986bc68a35561942480840395f0df168a061a
LOGIN_CODE_ACTIVE_WINDOW_SECONDS=60
LOGIN_CODE_RECORD_TTL_SECONDS=300
LOGIN_CODE_ISSUE_LIMIT=5
LOGIN_CODE_ISSUE_WINDOW_SECONDS=60
LOGIN_CODE_LEGACY_DB_AVAILABLE=true

# Fixed fake Unity login fixture. It is disabled unless explicitly enabled.
# Set the switch to false to revoke it immediately after a container restart.
# UNITY_DEV_LOGIN_FIXTURE_ENABLED=false
# UNITY_DEV_LOGIN_KEY_SHA256=<lowercase sha256 of the fixed raw test key>
# UNITY_DEV_LOGIN_FRONTEND_DOMAIN=d.dev.xrugc.com

# JWT - Path to the existing y1 secret key file used for HS256 signing
# SN reuses this JWT key and Redis; no new key or management API AES key is needed.
JWT_KEY=/path/to/jwt-secret.key

# Application
YII_DEBUG=false
YII_ENV=production
YII_CHECK_EVENTS=false

# Local identity admission candidate. Keep off until actual ingress/roster,
# Native continuation, CLI writers and process supervision are reviewed.
Y1_ADMISSION_ENABLED=false
# Existing boot-scoped raw private key file only; never generate at startup.
Y1_ADMISSION_CONTROL_URL=
Y1_ADMISSION_KEY_FILE=
Y1_ADMISSION_INSTANCE_ID=
Y1_ADMISSION_BOOT_ID=
Y1_ADMISSION_ROUTER_SHA256=
Y1_ADMISSION_GENERATION=
Y1_ADMISSION_REQUIRES_SESSION_CLOSE=false
Y1_ADMISSION_ALLOWED_CHILDREN=[]
Y1_ADMISSION_TIMEOUT_MS=1000
Y1_ADMISSION_CHILD_WAIT_MS=1500
# Revision is read only from the baked CI GIT_COMMIT artifact, not an env value.
# See docs/identity-admission.md for provenance and unimplemented boundaries.
